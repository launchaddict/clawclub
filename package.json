{
  "name": "clawclub-mcp",
  "version": "0.3.0",
  "description": "MCP server that lets people spend their idle Claude subscription windows on vetted, high-value tasks for charities — moving tasks to volunteers, not tokens to a pool.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "clawclub-mcp": "dist/index.js",
    "clawclub-autodonate": "dist/autodonate.js"
  },
  "files": [
    "dist",
    "board/demo-tasks.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
